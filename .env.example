# Copy to .env for Docker Compose; export these variables for native Python.
# Keep actual secrets out of Git. Grading supplies ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CODER_API_BUDGET_USD=5.5
# Conservative reserve rates in USD per million tokens, checked 2026-11-06.
ANTHROPIC_INPUT_USD_PER_MILLION=0.5
ANTHROPIC_OUTPUT_USD_PER_MILLION=2.5

# Optional local Qwen fallback. Leave backend empty on the CPU grader.
# Native Python: Ollama must already be running with the model pulled.
QWEN_BACKEND=
QWEN_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
QWEN_ENDPOINT=http://127.0.0.1:11434
